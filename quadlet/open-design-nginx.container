# nginx front for OpenDesign: gzip, immutable caching, SSE and WebSocket passthrough, the PDF export
# bridge injection (without it the UI's export button hits the desktop-only route and gets 501), and
# the only browser-facing credential check.
#
# It shares open-design's network namespace, so its lifecycle is bound to that container:
#   BindsTo=   stops nginx when the daemon stops (the namespace it lives in goes away)
#   WantedBy=  the daemon's start, including a Restart=always restart, pulls nginx back in
#
# ql-lint: allow wantedby
# This unit is WantedBy the daemon rather than by default.target on purpose: it cannot run without
# the namespace its owner creates, and starting it directly at boot would race that owner.
[Unit]
Description=Woow OpenDesign nginx front
Documentation=https://github.com/WOOWTECH/Woow_podman_opendesign
BindsTo=open-design.service
After=open-design.service

[Container]
ContainerName=open-design-nginx
Image=docker.io/library/nginx:1.30.4-alpine@sha256:dc5069ad14f19660b141b21236140b91656bf89bbc3e2417c70ae650cd66104c
Network=container:open-design
Label=io.woowtech.stack=open-design
Volume=%h/.config/open-design/nginx.conf:/etc/nginx/nginx.conf:ro,Z
Volume=%h/.config/open-design/nginx-auth.conf:/etc/nginx/woow-auth.conf:ro,Z
Volume=%h/.config/open-design/od-export-bridge.js:/etc/nginx/od-export-bridge.js:ro,Z
# apr1 hash of the open-design-api-token secret, derived by scripts/install.sh. The worker processes
# run as nginx (gid 101), hence group-readable.
Secret=open-design-htpasswd,type=mount,target=/etc/nginx/htpasswd,uid=0,gid=101,mode=0440
NoNewPrivileges=true
PidsLimit=128
PodmanArgs=--memory=128m --cpus=0.5
HealthCmd=wget -q -O /dev/null http://127.0.0.1:7456/api/health
HealthInterval=30s
HealthTimeout=10s
HealthRetries=5
HealthStartPeriod=15s

[Service]
Restart=always
TimeoutStartSec=300

[Install]
WantedBy=open-design.service
