# Woow OpenDesign daemon (upstream od 0.21.1 + headless export + OpenCode), rootless Quadlet.
#
# Network layout: the daemon owns a private network namespace on open-design.network and still binds
# only 127.0.0.1:7457 (its launcher forces OD_BIND_HOST). The nginx unit joins this namespace
# (Network=container:open-design), so it reaches the daemon over loopback exactly as it did with host
# networking. Only nginx's :7456 is published, on 127.0.0.1 by default, which replaces the old
# host-network nginx that listened on every interface.
#
# PidsLimit= is what podman-compose 1.0.6 silently dropped: the compose deployment ran with the 2048
# default even though the file said 512.
[Unit]
Description=Woow OpenDesign daemon
Documentation=https://github.com/WOOWTECH/Woow_podman_opendesign

[Container]
ContainerName=open-design
# Built from Dockerfile.full by scripts/install.sh; the tag is the repo VERSION file.
Image=localhost/woow-open-design:3.0.0
Pull=never
Network=open-design.network
HostName=open-design
Label=io.woowtech.stack=open-design
# nginx's port, published from the namespace owner.
PublishPort=@@OD_PUBLISH@@:7456

UserNS=keep-id:uid=1001,gid=1001
ReadOnly=true
Tmpfs=/tmp
Tmpfs=/home/open-design:mode=1777
Volume=open-design-data.volume:/app/.od
NoNewPrivileges=true
PidsLimit=512
# Quadlet 4.9.3 has no Memory=/Cpus= keys.
PodmanArgs=--memory=@@WOOW_OD_MEMORY@@ --cpus=@@WOOW_OD_CPUS@@

Environment=NODE_ENV=production
Environment=OD_BIND_HOST=127.0.0.1
Environment=OD_PORT=7457
Environment=OD_WEB_PORT=7457
# OD_ALLOWED_ORIGINS, NODE_OPTIONS, OD_CODEX_SANDBOX and the optional BYOK provider keys.
EnvironmentFile=%h/.config/open-design/open-design.env
# The daemon exempts loopback peers from this token, and nginx is always a loopback peer, so it only
# matters for API clients that reach the daemon from elsewhere. The browser-facing credential is the
# nginx Basic auth below, whose password is this same token.
Secret=open-design-api-token,type=env,target=OD_API_TOKEN

HealthCmd=curl -fsS -o /dev/null http://127.0.0.1:7457/api/health
HealthInterval=30s
HealthTimeout=10s
HealthRetries=5
HealthStartPeriod=60s
PodmanArgs=--stop-timeout=15

[Service]
Restart=always
TimeoutStartSec=300
TimeoutStopSec=45

[Install]
WantedBy=default.target
