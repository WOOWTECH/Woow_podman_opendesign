# ~/.config/open-design/open-design.env: created by scripts/install.sh (mode 0600) and passed to the
# daemon through EnvironmentFile= (no '-' prefix: the file must exist).
#
# Rules: KEY=VALUE, no quotes, no inline "# comments" after a value. The generated credentials are
# podman secrets, not settings here:
#   open-design-api-token   browser login password (user "open-design") and the daemon's API token
#   open-design-htpasswd    the apr1 hash nginx checks, derived from that token
# Read the token in a private terminal with:
#   podman secret inspect --showsecret --format '{{.SecretData}}' open-design-api-token
# After editing this file, run scripts/install.sh again.

# Every scheme://host:port the UI is opened from (loopback, LAN IP, tailnet name, tunnel hostname).
# A missing origin answers HTTP 403 {"error":"Cross-origin requests are not allowed"} on every data
# route while the UI still renders. install.sh refuses to continue when the local origin is missing.
OD_ALLOWED_ORIGINS=http://127.0.0.1:7456,http://localhost:7456

# Node heap. Keep it well under WOOW_OD_MEMORY so the OOM killer does not fire during an export.
NODE_OPTIONS=--max-old-space-size=1536
# Codex sandbox mode; leave empty for the default.
OD_CODEX_SANDBOX=

# Optional BYOK provider keys (they can also be set on the Models page, which stores them in the
# data volume). Leave empty to configure them in the UI.
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- installer knobs (read by scripts/install.sh) ---
# 127.0.0.1 (default), an IPv4 address of this host, or "all" (every address, IPv4 and IPv6).
WOOW_OD_BIND=127.0.0.1
WOOW_OD_PORT=7456
# basic = nginx asks for user "open-design" and the token as password (default).
# off   = no credential check in nginx; only for a stack behind an authenticating proxy.
WOOW_OD_AUTH=basic
WOOW_OD_MEMORY=2g
WOOW_OD_CPUS=2
# CPUs the image build may use (podman build --cpuset-cpus), so a build does not starve the host.
WOOW_OD_BUILD_CPUS=
