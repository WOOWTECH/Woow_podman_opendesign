# Woow Podman Open Design — sample environment.
# Copy to .env and edit; .env is git-ignored.
#
#   cp .env.example .env
#   # edit .env
#   podman-compose -f docker-compose.podman.yml up -d

# --- image + ports -----------------------------------------------------------
# Local image tag built from Dockerfile.full. Keep in sync with the tag used
# by scripts/install.sh.
OPEN_DESIGN_IMAGE=open-design-full

# Public port served by the nginx sidecar. The OD daemon itself listens on
# 127.0.0.1:7457 (loopback-only) and is only reachable through nginx.
OPEN_DESIGN_PORT=7456
OPEN_DESIGN_INTERNAL_PORT=7457

# --- CORS ---------------------------------------------------------------
# Comma-separated allowlist of browser-facing origins. EVERY hostname the
# UI is going to be opened from must be listed here, or pi-web's origin
# validator returns HTTP 403 "Cross-origin requests are not allowed" and
# the UI renders but every data route fails.
#
# Fill in the LAN IP, tailnet IP + MagicDNS name, and any Cloudflare Tunnel
# hostname that fronts this deployment. Leave 127.0.0.1 in for local dev.
OPEN_DESIGN_ALLOWED_ORIGINS=http://127.0.0.1:7456,http://<LAN-IP>:7456

# --- authentication ---------------------------------------------------------
# 64-char hex token; only enforced when OPEN_DESIGN_DISABLE_API_AUTH is
# unset or 0. Generate with:  openssl rand -hex 32
OD_API_TOKEN=

# Set to 1 for LAN-only trust boundaries where a downstream reverse proxy
# (nginx, NPM, cloudflared + CF Access) already handles authentication.
# Set to 0/empty in any deployment where a browser can reach this stack
# without another auth layer in front.
OPEN_DESIGN_DISABLE_API_AUTH=1

# --- runtime tuning ---------------------------------------------------------
# Container memory ceiling. The Chromium in the image plus Playwright plus
# the OD daemon comfortably fit inside 2g on hosts with headless PDF/PPTX
# export enabled; drop to 384m for a UI-only deployment.
OPEN_DESIGN_MEM_LIMIT=2g

# Node heap. Keep well under OPEN_DESIGN_MEM_LIMIT so the OOM killer does
# not fire under a spike of media generation. 1536 pairs with a 2g limit.
NODE_OPTIONS=--max-old-space-size=1536

# Codex sandbox mode. Leave blank for the default; set only if you know
# you need a non-default value.
OD_CODEX_SANDBOX=

# --- provider API keys (optional, BYOK) -------------------------------------
# Filled in the Models page of the UI once the stack is up; the values here
# are only picked up on container start. Leave blank to configure via UI.
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
