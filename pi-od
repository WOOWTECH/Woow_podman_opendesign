#!/bin/sh
# Scope Pi's persistent HOME to the existing pi-agent-data volume without
# changing the Open Design daemon's HOME (which other agent runtimes use).
set -eu

: "${PI_AGENT_DATA_DIR:=/data/pi-agent}"

if [ ! -d "${PI_AGENT_DATA_DIR}" ]; then
    echo "pi-od: ${PI_AGENT_DATA_DIR} is not mounted" >&2
    exit 78
fi

export HOME="${PI_AGENT_DATA_DIR}/home"
export PI_CODING_AGENT_DIR="${PI_AGENT_DATA_DIR}"
export PI_TELEMETRY="${PI_TELEMETRY:-0}"
export PI_SKIP_VERSION_CHECK="${PI_SKIP_VERSION_CHECK:-1}"

exec /usr/local/bin/pi "$@"
