# Open-Design — podman-stack environment
#
# Copy this file to .env and edit values as needed:
#   cp .env.example .env
#
# .env is git-ignored (see repo .gitignore). Never commit real secrets.

# --- od-console ---
# Host port exposed on 0.0.0.0. Change if :4000 conflicts.
OD_CONSOLE_PORT=4000

# --- how od-console reaches the host-side od-runner ---
# In rootless podman on Linux, host.containers.internal resolves to the
# host gateway. Leave this as-is unless you know you need something else.
OD_RUNNER_HOST=host.containers.internal
OD_RUNNER_PORT=7001

# --- Node runtime ---
NODE_ENV=production
