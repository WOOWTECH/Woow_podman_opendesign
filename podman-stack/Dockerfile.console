# Dockerfile for od-console (podman branch)
#
# This is deliberately small: it only builds the web GUI under ../console/.
# Playwright + Chromium do NOT belong in this image — that work happens on
# the host (see ../host-install/install.sh).
#
# Build context: repo root (so we can COPY console/).
# Referenced by: podman-stack/compose.yml

FROM docker.io/library/node:22-bookworm-slim AS build

WORKDIR /app

# Install console dependencies. We copy manifests first for better layer
# caching, then the rest of the console source.
COPY console/package.json console/package-lock.json* ./
RUN npm ci --no-audit --no-fund || npm install --no-audit --no-fund

COPY console/ ./

# If the console has a build step (e.g. next build / vite build), run it
# here. If it doesn't, the script is a no-op.
RUN if [ -f package.json ] && node -e "process.exit(!(require('./package.json').scripts||{}).build)"; then npm run build; fi

# ---------------------------------------------------------------------------
# runtime stage
# ---------------------------------------------------------------------------
FROM docker.io/library/node:22-bookworm-slim AS runtime

ENV NODE_ENV=production \
    PORT=4000

WORKDIR /app

# Copy the built app from the build stage.
COPY --from=build /app /app

# Minimal runtime deps (wget for healthcheck).
RUN apt-get update \
    && apt-get install -y --no-install-recommends wget ca-certificates tini \
    && rm -rf /var/lib/apt/lists/*

# Drop to a non-root user (rootless podman still benefits from a non-root
# user inside the container).
RUN groupadd -r odconsole && useradd -r -g odconsole -d /app -s /usr/sbin/nologin odconsole \
    && chown -R odconsole:odconsole /app
USER odconsole

EXPOSE 4000

ENTRYPOINT ["/usr/bin/tini", "--"]
# Prefer a "start" script if defined; otherwise fall back to server.js.
CMD ["sh", "-c", "if node -e \"process.exit(!(require('./package.json').scripts||{}).start)\"; then npm run start; else node server.js; fi"]
