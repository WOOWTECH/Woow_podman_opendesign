# Woow OpenDesign for rootless podman: the shared WoowTech OpenDesign core (the image the PaaS
# service and the HA add-on are built on) plus this repo's thin shell: the launcher, the headless
# export renderer and the /app/.od data layout.
#
# The core provides OpenDesign 0.24.1, Claude Code, Codex, Pi, OpenCode, Chromium and the CJK fonts.
# amd64 only: the core is built for linux/amd64.
ARG BUILD_FROM=ghcr.io/woowtech/open-design-core:20261101.2319@sha256:a3d1e6ce84774d11e03a31b379be438b5f53fe832ddd4b72d31fc837462bbd62

# Built-in MCP server: admin UI assets, built with the core's own Node from the vendored, lock-pinned
# sources. Only dist/ is kept. --include=dev because the core sets NODE_ENV=production.
FROM ${BUILD_FROM} AS woow-mcp-ui
USER root
WORKDIR /ui
COPY mcp-runtime/ha/vendor/packages/mcp-admin-ui/ ./
# The sources are a pinned copy of the HA add-on's and say "Home Assistant"; only the words change here.
COPY config/mcp-admin-wording.sed /tmp/mcp-admin-wording.sed
RUN sed -i -f /tmp/mcp-admin-wording.sed src/app.js src/api.js src/contracts.js src/index.html \
    && ! grep -nE 'Home Assistant|HA |Add-on|Ingress|預設唯讀' src/app.js src/api.js src/contracts.js src/index.html
RUN /usr/local/bin/npm ci --include=dev --ignore-scripts --no-audit --no-fund \
    && /usr/local/bin/npm run build \
    && test -f dist/index.html

FROM ${BUILD_FROM}

# Versions the core must provide; the contract below fails the build on any mismatch.
# OpenDesign 0.24.1 ships its daemon as package version 0.23.1.
ARG CORE_OPENDESIGN_VERSION=0.24.1
ARG CORE_DAEMON_PACKAGE_VERSION=0.23.1
ARG CORE_CLAUDE_CODE_VERSION=2.1.296
ARG CORE_CODEX_VERSION=0.162.1
ARG CORE_PI_VERSION=1.1.0
ARG CORE_OPENCODE_VERSION=1.18.33

USER root

# The core's defaults target the PaaS chart (HOME=/home/opendesign). Here everything stateful lives
# in the one data volume, /app/.od.
ENV OD_BIND_HOST=127.0.0.1 \
    OD_PORT=7457 \
    OD_DATA_DIR=/app/.od \
    HOME=/app/.od/home

# The web terminal. Everything else comes from the core.
RUN apk add --no-cache ttyd=1.7.7-r0 \
    && rm -rf /var/cache/apk/*

COPY runtime/package.json runtime/package-lock.json /opt/woow-opendesign/
# Absolute npm path: a build frontend may supply a reduced PATH.
RUN /usr/local/bin/npm ci --omit=dev --prefix /opt/woow-opendesign \
    && /usr/local/bin/npm cache clean --force

# Built-in MCP server (mcp-runtime/): code under /opt/woow, root-owned and read-only, user mcp (10001).
COPY --from=woow-mcp-ui /ui/dist /opt/woow/packages/mcp-admin-ui/dist
COPY mcp-runtime/ /tmp/mcp-runtime/
RUN sh /tmp/mcp-runtime/install.sh && rm -rf /tmp/mcp-runtime

COPY rootfs/ /
# Tools that resolve the passwd home instead of $HOME (OpenCode keeps its cache, data and state
# there) must land in the data volume too, not on the read-only root filesystem.
# Root-owned and not writable by UID 1001: the agents run as that UID, and the export renderer runs
# in the daemon that serves their results.
RUN set -eu; \
    # The npm run above used this HOME as root. A new volume is copied from here, so nothing of that
    # run may stay: the volume must start with an empty home owned by the runtime user.
    rm -rf /app/.od/home; \
    mkdir -p /app/.od/home; \
    chown -R open-design:open-design /app/.od; \
    awk -F: 'BEGIN{OFS=":"} $1=="open-design"{$6="/app/.od/home"} {print}' /etc/passwd > /tmp/passwd; \
    cat /tmp/passwd > /etc/passwd; \
    rm -f /tmp/passwd; \
    test "$(getent passwd open-design | cut -d: -f6)" = /app/.od/home; \
    chmod 0755 \
      /usr/local/bin/podman-opendesign \
      /usr/local/bin/podman-opendesign-terminal \
      /opt/woow-opendesign/headless-entry.mjs \
      /opt/woow-opendesign/headless-renderer.mjs; \
    chown -R root:root /opt/woow-opendesign; \
    chmod -R go-w /opt/woow-opendesign

ARG BUILD_VERSION=4.1.2
ARG BUILD_DATE
ARG BUILD_REF
ARG BUILD_REPOSITORY=WOOWTECH/Woow_podman_opendesign

LABEL org.opencontainers.image.title="Woow Podman OpenDesign" \
      org.opencontainers.image.description="OpenDesign for rootless podman, on the shared WoowTech core" \
      org.opencontainers.image.vendor="WOOWTECH" \
      org.opencontainers.image.licenses="MIT" \
      org.opencontainers.image.source="https://github.com/${BUILD_REPOSITORY}" \
      org.opencontainers.image.created="${BUILD_DATE}" \
      org.opencontainers.image.revision="${BUILD_REF}" \
      org.opencontainers.image.version="${BUILD_VERSION}"

# Under keep-id the container already runs as 1001; there is no root to drop.
USER open-design

# Core contract, as the runtime user, so a broken image fails here instead of at 03:00 in prod.
RUN set -eu; \
    test "$(id -u)" = 1001; \
    test -f /app/apps/daemon/dist/server.js; \
    test -d /app/apps/web/out; \
    grep -Fq "\"version\": \"${CORE_DAEMON_PACKAGE_VERSION}\"" /app/apps/daemon/package.json; \
    test "$OD_APP_VERSION" = "$CORE_OPENDESIGN_VERSION"; \
    test -f /app/skills/woowtech-brand/SKILL.md; \
    test ! -e /app/skills/brainstorming; \
    test "$(claude --version | awk '{print $1}')" = "$CORE_CLAUDE_CODE_VERSION"; \
    test "$(codex --version | awk '{print $2}')" = "$CORE_CODEX_VERSION"; \
    test "$(pi --version | tr -d '[:space:]')" = "$CORE_PI_VERSION"; \
    test "$(opencode --version | tr -d '[:space:]')" = "$CORE_OPENCODE_VERSION"; \
    for b in bash node npm chromium-browser curl tini ttyd; do \
      command -v "$b" >/dev/null || { echo "missing: $b"; exit 1; }; \
    done; \
    fc-list | grep -qi 'Noto Sans CJK'; \
    test ! -w /opt/woow-opendesign; \
    test ! -w /opt/woow; \
    test -x /opt/woow/bin/paas-opendesign-mcp; \
    ! id -nG | tr ' ' '\n' | grep -qx mcp; \
    node -e "import('/opt/woow-opendesign/headless-renderer.mjs').then(m=>{if(typeof m.renderSlides!=='function')throw new Error('renderSlides missing');console.log('renderSlides ok')})"

ENTRYPOINT ["/sbin/tini", "--", "/usr/local/bin/podman-opendesign"]
CMD []
